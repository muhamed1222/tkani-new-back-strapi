# Пример файла .env для centertkani.ru
# Скопируйте этот файл в .env и заполните значения

# Режим работы
FLASK_ENV=production
DEBUG=False

# Секретные ключи (ОБЯЗАТЕЛЬНО измените!)
# Сгенерируйте новые ключи командой:
# python3 -c "import secrets; print('SECRET_KEY=' + secrets.token_urlsafe(32))"
SECRET_KEY=ВАШ_СЕКРЕТНЫЙ_КЛЮЧ_МИНИМУМ_32_СИМВОЛА
JWT_SECRET_KEY=ВАШ_JWT_СЕКРЕТНЫЙ_КЛЮЧ_МИНИМУМ_32_СИМВОЛА

# Домены
FRONTEND_URL=https://centertkani.ru
API_BASE_URL=https://api.centertkani.ru
STRAPI_URL=https://cms.centertkani.ru

# CORS (разрешенные домены)
ALLOWED_ORIGINS=https://centertkani.ru,https://www.centertkani.ru

# База данных (для production используйте PostgreSQL!)
# SQLite (только для разработки):
# DATABASE_URL=sqlite:///app.db
# PostgreSQL (рекомендуется для production):
DATABASE_URL=postgresql://user:password@localhost:5432/tkani_db

# ЮMoney (обновите redirect URI!)
YOOMONEY_SHOP_ID=ваш_shop_id
YOOMONEY_SECRET_KEY=ваш_secret_key
YOOMONEY_REDIRECT_URI=https://api.centertkani.ru/api/v1/payment/yoomoney/callback

# СДЭК
CDEK_ACCOUNT=ваш_аккаунт
CDEK_SECURE_PASSWORD=ваш_пароль
CDEK_API_URL=https://api.cdek.ru/v2

# Почта России
RUSSIAN_POST_API_URL=https://otpravka-api.pochta.ru
RUSSIAN_POST_TOKEN=sqqJ1yQTlXYGFCcpLZpZXG6Zx7NDmnxp
RUSSIAN_POST_KEY=

# Порт (по умолчанию 5001)
PORT=5001

# Rate Limiting
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_AUTH=5 per minute

# Кэширование
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300

# PostgreSQL Connection Pooling (опционально)
DB_POOL_SIZE=20
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=40

# Логирование
LOG_LEVEL=WARNING
LOG_FILE=/var/log/tkani/app.log

# Sentry (мониторинг ошибок - опционально)
# Получите DSN на https://sentry.io
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# Резервное копирование
BACKUP_DIR=/var/backups/tkani
BACKUP_RETENTION_DAYS=30

