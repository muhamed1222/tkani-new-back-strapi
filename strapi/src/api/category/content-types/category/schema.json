{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Категории"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "section": {
      "type": "enumeration",
      "enum": [
        "clothing",
        "home",
        "furniture"
      ],
      "required": true,
      "default": "clothing"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "category"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "seo.seo-fields"
    }
  }
}