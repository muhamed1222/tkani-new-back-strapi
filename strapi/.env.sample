# Strapi Configuration
HOST=0.0.0.0
PORT=1337
APP_KEYS=your-app-key-1,your-app-key-2,your-app-key-3,your-app-key-4
API_TOKEN_SALT=your-api-token-salt
ADMIN_JWT_SECRET=your-admin-jwt-secret
TRANSFER_TOKEN_SALT=your-transfer-token-salt
JWT_SECRET=your-jwt-secret

# Database
DATABASE_CLIENT=better-sqlite3
DATABASE_FILENAME=.tmp/data.db

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Upload Plugin (Local Storage)
# Для перехода на S3/R2 раскомментируйте и настройте:
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_ACCESS_SECRET=your-aws-secret-access-key
# AWS_REGION=your-aws-region
# AWS_BUCKET=your-aws-bucket-name

# Email Plugin (Nodemailer)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=centertkani-shop@yandex.com
SMTP_PASSWORD=bmavdsbxyuqmmztm
SMTP_SECURE=true
SMTP_TLS=true

# Sentry
SENTRY_ENABLED=false
SENTRY_DSN=your-sentry-dsn-here

# Payments - YooKassa
# YOOKASSA_SHOP_ID=your-yookassa-shop-id
# YOOKASSA_API_KEY=your-yookassa-api-key

# Environment
NODE_ENV=development
